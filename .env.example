# ============================================================================
# CONFIGURACIÓN DEL ENTORNO - RFID Games Platform
# ============================================================================
# Copiar este archivo como .env y configurar los valores
#
#   cp .env.example .env
#
# Autor: Samuel Blanchart Pérez
# Versión: 1.0.0
# ============================================================================

# ============================================================================
# SERVIDOR
# ============================================================================
PORT=5000
NODE_ENV=development
# Opciones: development | production | test

# Entorno de despliegue (cloud).
# Independiente de NODE_ENV — en cloud NODE_ENV siempre es "production".
# Opciones: development | staging | production
APP_ENV=development

# Trust proxy: confiar en la primera capa de reverse proxy (Koyeb, nginx).
# Necesario para que `req.ip` y los rate limiters basados en IP funcionen
# bien detrás de un proxy. Se activa automáticamente con NODE_ENV=production;
# se puede forzar a "true" en otros entornos cuando se prueba con un proxy real.
# TRUST_PROXY=true

# Seed automático al boot si la base de datos está vacía.
# Sólo recomendado en el servicio api-staging tras un reset del cluster.
# En producción mantener "false" (o sin definir).
SEED_ON_BOOT=false

# ============================================================================
# BASE DE DATOS - MongoDB
# ============================================================================
# Para desarrollo local con Docker:
MONGO_URI=mongodb://mongo:27017/rfid_games_db

# Contraseña y usuario para Mongo Express (para Docker):
ME_CONFIG_BASICAUTH_USERNAME=tu_usuario_mongo_express
ME_CONFIG_BASICAUTH_PASSWORD=tu_contraseña_mongo_express

# Para MongoDB Atlas (producción):
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/rfid_games_db

# ============================================================================
# CACHÉ - Redis
# ============================================================================
# Para desarrollo local con Docker (incluye password):
REDIS_URL=redis://:devRedis123!@redis:6379

# Contraseña de Redis. Docker Compose la inyecta en --requirepass.
# En desarrollo se usa el default devRedis123! si no se define.
# En producción es OBLIGATORIO definir una contraseña fuerte.
REDIS_PASSWORD=devRedis123!

# Para Redis Cloud (producción):
# REDIS_URL=redis://:password@host:port

# Opcional: prefijo para keys (default: rfid-games:).
#
# IMPORTANTE — Configuración por entorno:
#  • Desarrollo local: deja el default `rfid-games:` o ponlo a `eduplay:dev:`.
#  • Staging (Koyeb api-staging): REDIS_KEY_PREFIX=eduplay:staging:
#  • Producción (Koyeb api-prod):  REDIS_KEY_PREFIX=eduplay:prod:
#
# Si dejas el prefix igual entre staging y prod compartiendo la misma DB
# Upstash, las keys colisionan (rate limits, sessions, caches, BullMQ).
# El backend emite un warning de boot si APP_ENV está definido y el prefix
# no contiene su nombre — ver `backend/src/utils/envValidator.js`.
# REDIS_KEY_PREFIX=eduplay:staging:
# REDIS_KEY_PREFIX=eduplay:prod:

# ============================================================================
# AUTENTICACIÓN JWT
# ============================================================================
# ⚠️ IMPORTANTE: Generar valores únicos y seguros para producción.
# T-905 (hardening B1): mínimo 64 chars + entropía Shannon ≥3.5 bits/char.
# Usar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Validación automática al arrancar — el servidor falla fast si el secret es inseguro.

JWT_SECRET=tu_secret_jwt_minimo_64_caracteres_aqui_generado_con_crypto_randomBytes
JWT_REFRESH_SECRET=tu_secret_refresh_minimo_64_caracteres_distinto_del_JWT_SECRET

# Tiempos de expiración
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# ACCOUNT LOCKOUT (T-905 B1) — defensa contra credential stuffing per-user
# ============================================================================
# Keying por email (no IP) para detectar ataques distribuidos.
# Tras MAX_ATTEMPTS fallos en WINDOW_MS → cuenta bloqueada DURATION_MS.
# Fail-open: si Redis no responde, NO bloquea logins.
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_MS=900000
ACCOUNT_LOCKOUT_DURATION_MS=900000

# ============================================================================
# CIFRADO SIMÉTRICO DE CAMPOS SENSIBLES (T-905 B2)
# ============================================================================
# Clave maestra AES-256-GCM (32 bytes hex = 64 chars) para cifrar TOTP secrets
# de MFA en BD (B7) y futuros campos sensibles.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En dev/test se deriva de JWT_SECRET si está ausente; en producción es OBLIGATORIA.
# MFA_ENCRYPTION_KEY=tu_clave_de_32_bytes_hexadecimales_aqui_64_chars_total

# ============================================================================
# CSP - Content Security Policy (T-905 B5)
# ============================================================================
# Dominio WebSocket de producción (incluido en CSP connectSrc cuando NODE_ENV=production).
# Ejemplo: wss://api-prod.eduplay.koyeb.app
# WSS_DOMAIN=

# Modo Report-Only: recolecta violaciones CSP en /api/csp-report sin bloquear.
# Útil para validar política nueva en staging durante 1 semana antes de enforce.
# CSP_REPORT_ONLY=false

# ============================================================================
# MFA TOTP (T-905 B7) — super_admin con autenticación de doble factor
# ============================================================================
# Secret para firmar MFA tokens cortos (5min) tras challenge TOTP.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_MFA_SECRET=

# Default `true` en producción: el super_admin sin MFA recibe 428 al acceder a
# endpoints protegidos. Pone a `false` SOLO para migración inicial o dev.
# MFA_REQUIRED_FOR_SUPER_ADMIN=true

# ============================================================================
# Seudonimización de datos de menores (RGPD Art. 4.5 / EDPB 01/2025)
# ============================================================================
# Clave HMAC-SHA256 para generar pseudoIds de estudiantes NO recomputables sin
# el secreto (evita la re-identificación desde logs). OBLIGATORIO en producción
# (el backend no arranca sin ella). En dev, si falta, degrada a SHA-256 sin clave.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PSEUDONYMIZE_SECRET=

# Emergencia: si super_admin pierde phone Y backup codes, configurar con su id
# y redesplegar — al arrancar el server resetea mfa.enabled=false para ese user.
# Tras desbloquear, volver a quitar la variable y redesplegar para cerrar la puerta.
# MFA_EMERGENCY_DISABLE_USER_ID=

# ============================================================================
# TURNSTILE - Cloudflare CAPTCHA (T-905 B6)
# ============================================================================
# Activación opt-in: si ambas vars existen, el login pide CAPTCHA tras 3 fallos.
# Obtener en: https://dash.cloudflare.com/?to=/:account/turnstile
# Backend: secret server-side
# TURNSTILE_SECRET=
# Frontend: site key (pública, expuesta en bundle)
# VITE_TURNSTILE_SITEKEY=
# Umbral de fallos antes de exigir CAPTCHA (default 3)
# TURNSTILE_FAILURE_THRESHOLD=3

# ============================================================================
# SEGURIDAD - CORS
# ============================================================================
# Lista de orígenes permitidos (separados por coma)
CORS_WHITELIST=http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_REQUESTS_DEV=2000
RATE_LIMIT_AUTH_MAX_REQUESTS_DEV=400

# ============================================================================
# ALMACENAMIENTO - Supabase Storage (para assets de juegos)
# ============================================================================
# Obtener de: https://supabase.com/dashboard/project/[project]/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_key_aqui
SUPABASE_BUCKET=game-assets

# ============================================================================
# RFID - Fuente de eventos (cliente Web Serial)
# Opciones: client | disabled
# ============================================================================
RFID_SOURCE=client

# ============================================================================
# RFID HMAC validation (T-905 B8) — anti-replay del UID con counter EEPROM
# ============================================================================
# Secret compartido entre firmware (build-time -DRFID_HMAC_SECRET) y backend.
# DEBE ser idéntico en ambos. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dev/local: usa un valor cualquiera de 64 hex (no es el de producción).
# Producción: provisiona un secret único en el env del backend (Koyeb) y flashea
# el firmware con el MISMO valor.
RFID_HMAC_SECRET=

# Enforcement ACTIVO: el backend rechaza scans web_serial sin HMAC válido o con
# counter de replay. Los fallbacks táctiles (juego sin sensor) están exentos.
# Si pones true SIN secret, el backend falla al arrancar en producción (fail-safe).
RFID_HMAC_ENABLED=true

# ============================================================================
# MONITOREO - Sentry (opcional)
# ============================================================================
SENTRY_ENABLED=false
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# T-904 Fase A: sampling explícito por entorno.
# Si no se setea, el backend usa defaults inferidos de APP_ENV:
#   - production → 0.1   (1 de cada 10 transacciones)
#   - staging    → 0.5   (más señal pre-release sin saturar la cuota free)
#   - resto      → 1.0   (dev/test al 100% para máxima visibilidad local)
# Bajar a 0.3 en staging si en QA pre-release la cuota se acerca al 80%.
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_PROFILES_SAMPLE_RATE=

# Frontend
VITE_SENTRY_ENABLED=false
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_APP_ENV=development   # development | staging | production (alinea sampling con backend)

# ============================================================================
# LOG SHIPPING - Grafana Cloud Loki (T-904 Fase B, opcional)
# ============================================================================
# Activa el envío de logs Pino a Grafana Cloud Loki vía pino-loki (multistream).
# Si está deshabilitado, los logs siguen escribiéndose sólo a stdout (Koyeb captura).
# Si está habilitado pero faltan HOST o TOKEN, el backend degrada silenciosamente
# y emite un warning en stderr al boot — no rompe el proceso.
LOG_SHIPPING_ENABLED=false

# Endpoint del data source Loki. Visible en Grafana Cloud → tu stack →
# Connections → Loki → "Send Logs". Ejemplo: https://logs-prod-eu-west-0.grafana.net
# LOG_SHIPPING_HOST=

# Username del data source (es un número, no un email). Visible en Loki Details
# del data source dentro del panel de Grafana Cloud.
# LOG_SHIPPING_USER=

# API token / password del data source. Se genera una sola vez al crear el data
# source; almacenarlo como *secret* en Koyeb, nunca commit.
# LOG_SHIPPING_TOKEN=

# Mínimo nivel exportado a Loki ('info' por defecto). Subir a 'debug' temporal
# si necesitas troubleshooting puntual; bajar a 'warn' para reducir volumen.
# LOG_SHIPPING_LEVEL=info

# Intervalo de batch en segundos (5 por defecto). No tocar salvo análisis de carga.
# LOG_SHIPPING_INTERVAL_S=5

# ============================================================================
# FRONTEND - Variables Vite (consumidas en build-time por el frontend)
# ============================================================================
# URL base del backend para llamadas Axios.
# Local: http://localhost:5000/api
# Staging: https://api-staging-<tu-org>.koyeb.app/api
# Prod: https://api-<tu-org>.koyeb.app/api
VITE_API_URL=http://localhost:5000/api

# URL del Socket.IO (sin /api). Suele coincidir con el host del backend.
# Local: http://localhost:5000
# Cloud: https://api-staging-<tu-org>.koyeb.app o https://api-<tu-org>.koyeb.app
VITE_SOCKET_URL=http://localhost:5000

# Mecánicas de juego habilitadas en el selector de creación de sesión.
# Lista CSV, valores válidos: memory,association,sequence
VITE_ENABLED_SESSION_MECHANICS=memory,association,sequence

# ============================================================================
# LOGGING
# ============================================================================
# Nivel de log: error | warn | info | debug
# LOG_LEVEL=info

# ============================================================================
# SUPER ADMIN (para seeder inicial)
# ============================================================================
SUPER_ADMIN_EMAIL=admin@test.com
SUPER_ADMIN_PASSWORD=Admin1234!
