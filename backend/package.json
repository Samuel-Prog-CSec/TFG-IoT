{
  "name": "rfid-games-backend",
  "version": "1.0.0",
  "description": "Backend server for RFID educational games - MERN stack",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "bootstrap": "node scripts/bootstrap.js",
    "dev": "nodemon src/server.js",
    "dev:multi-1": "cross-env PORT=5000 INSTANCE_NAME=node-A MONGO_URI=mongodb://localhost:27017/rfid_games_db REDIS_URL=redis://:devRedis123!@localhost:6379 node src/server.js",
    "dev:multi-2": "cross-env PORT=5001 INSTANCE_NAME=node-B MONGO_URI=mongodb://localhost:27017/rfid_games_db REDIS_URL=redis://:devRedis123!@localhost:6379 node src/server.js",
    "test:multi-instance": "node scripts/test-socket-multiinstance.js",
    "seed": "node seeders/index.js",
    "seed:reset": "node seeders/index.js --reset",
    "seed:if-empty": "node scripts/seed-if-empty.js",
    "seed:storage": "node scripts/seed-storage-assets.js",
    "seed:bulk-students": "node scripts/seed-bulk-students.js",
    "migrate:sessions": "node scripts/migrate-session-status.js",
    "migrate:dominant-colors": "node scripts/backfill-dominant-colors.js",
    "migrate:birthdate": "node scripts/migrateBirthdate.js",
    "migrate:assets-uploadedby": "node scripts/migrate-assets-uploadedby.js",
    "migrate:clamp-scores": "node scripts/migrate-clamp-scores.js",
    "migrate:alerts-backfill": "node scripts/migrate-alerts-backfill.js",
    "migrate:alerts-backfill:dry-run": "node scripts/migrate-alerts-backfill.js --dry-run",
    "migrate:mechanic-type": "node scripts/migrate-mechanic-type.js",
    "migrate:mechanic-type:dry-run": "node scripts/migrate-mechanic-type.js --dry-run",
    "migrate:score-percent": "node scripts/migrate-score-percent.js",
    "migrate:score-percent:dry-run": "node scripts/migrate-score-percent.js --dry-run",
    "migrate:leaderboard-percent": "node scripts/migrate-leaderboard-percent.js",
    "migrate:drop-redundant-indexes": "node scripts/migrate-drop-redundant-indexes.js",
    "migrate:drop-redundant-indexes:dry-run": "node scripts/migrate-drop-redundant-indexes.js --dry-run",
    "data:audit": "node scripts/dataAudit.js",
    "data:retention": "node scripts/dataRetention.js",
    "data:retention:dry-run": "node scripts/dataRetention.js --dry-run",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "bench:sessions": "node scripts/benchmark-session-reads.js",
    "drop-db": "node scripts/drop-db.js",
    "lint": "eslint .",
    "lint:test": "eslint ./tests/**/*.js",
    "lint:staged": "eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"seeders/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"seeders/**/*.js\"",
    "test": "cross-env NODE_ENV=test jest",
    "security:check-&-fix": "npm audit && npm audit fix",
    "audit:full": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "audit:full:json": "npm audit --json",
    "audit:prod:json": "npm audit --omit=dev --json",
    "deps:update-minor": "npx npm-check-updates -t minor -u && npm install",
    "deps:analyze": "npx npm-check-updates && npx depcheck && npm outdated"
  },
  "keywords": [
    "rfid",
    "backend",
    "educational_games",
    "mern",
    "iot",
    "nodejs",
    "express",
    "mongodb",
    "socket.io",
    "sentry",
    "api_rest"
  ],
  "author": "Samuel Blanchart Pérez",
  "dependencies": {
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.105.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "music-metadata": "^11.12.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "rate-limit-redis": "^6.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.5.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "brace-expansion": ">=5.0.5",
    "socket.io-parser": "^4.2.6",
    "@apidevtools/json-schema-ref-parser": "^14.0.1",
    "@apidevtools/swagger-parser": "^12.1.0"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
